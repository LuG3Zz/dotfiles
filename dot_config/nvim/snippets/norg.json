{
  "meta": {
    "prefix": "meta",
    "body": [
      "@document.meta",
      "    title: ${1:Title}",
      "    description: ${2:Description}",
      "@end",
      "$0"
    ],
    "description": "document metadata block"
  },
  "code": {
    "prefix": "code",
    "body": [
      "@code ${1:language}",
      "$0",
      "@end"
    ],
    "description": "code block"
  },
  "linkf": {
    "prefix": "linkf",
    "body": "{:${1:filename}:}",
    "description": "link to norg file"
  },
  "linkh": {
    "prefix": "linkh",
    "body": "{* ${1:heading}}",
    "description": "link to heading"
  },
  "linku": {
    "prefix": "linku",
    "body": "{${1:url}}",
    "description": "external link"
  },
  "linkt": {
    "prefix": "linkt",
    "body": "{${1:target}}[${2:text}]",
    "description": "link with custom text"
  },
  "anchor": {
    "prefix": "anchor",
    "body": [
      "[${1:name}]{${2:target}}"
    ],
    "description": "anchor link"
  },
  "img": {
    "prefix": "img",
    "body": ".image ${1:url}",
    "description": "embedded image"
  }
}
